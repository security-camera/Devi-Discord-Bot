# File must be named ".env"

#Bot main config
BOT_TOKEN=token
TECHNICAL_SUPPORT_SERVER=guild_id
AI_SIGNAL_CHANNEL=channel_id

BOT_TOKEN_TEST=token
TECHNICAL_SUPPORT_SERVER_TEST=guild_id
AI_SIGNAL_CHANNEL_TEST=channel_id

DATABASE_URL="postgresql://url"
ENCRYPTION_KEY=generated_by_fernet
TEST_SERVER=guild_id
TOP_GG_TOKEN=token

#Dashboard API (used by the website; leave DASHBOARD_API_TOKEN empty to turn it off)
DASHBOARD_API_TOKEN="token (see https://github.com/security-camera/Devi-Site)"
DASHBOARD_API_HOST=ip
DASHBOARD_API_PORT=port

TEST_ENABLED=0/1

#Bot varuables config

#Temp voices
DEFAULT_NAME_TEMPLATE="[user]'s channel"
ADMINS_CAN_MANAGE_TEMP_CHANNELS=False

#Voice cog
MAX_TTS_LENGTH=400
MAX_TTS_LENGTH_VOTED=800
EMPTY_CHANNEL_TIMEOUT=60
FALLBACK_VOICE=ru_RU-ruslan-medium
TTS_PLAYBACK_TIMEOUT=180

#Triggers
RESPONSE_COOLDOWN=3
RESPONSE_COOLDOWN_VOTED=0

#Mentions
MAX_MENTIONS=10
MENTIONS_COOLDOWN_TIME=60
MAX_MENTIONS_VOTED=30
MENTIONS_COOLDOWN_TIME_VOTED=30

#Clear
CLEAR_COUNT=500
CLEAR_COUNT_VOTED=1500

#Birthdays
BIRTHDAY_CHECK_HOUR_UTC=9

#AI - ONE shared API key serves every server and user. Pick ONE provider.
# proxyapi: key at https://console.proxyapi.ru/keys, top up at https://console.proxyapi.ru/billing (rubles, Russian card or SBP)
# deepseek: key at https://platform.deepseek.com/api_keys (prepaid balance = hard spending cap)
# qwen: key at https://modelstudio.console.alibabacloud.com (Singapore region)
AI_PROVIDER=proxyapi
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides, the defaults come from AI_PROVIDER (proxyapi: qwen/qwen3.7-flash, deepseek: deepseek-flash, qwen: qwen3.7-flash)
# ProxyAPI model ids look like vendor/model, e.g. qwen/qwen3.7-flash, deepseek/deepseek-v4-flash, mistralai/mistral-small-3.2-24b-instruct
#AI_BASE_URL=
#AI_TEXT_MODEL=
# Used only for messages with images, must be a vision model
#AI_VISION_MODEL=
# JSON that is merged into every request, replaces the built-in way of switching the hidden "thinking" off
#AI_EXTRA_BODY={"reasoning_effort": "none"}
# OpenAI models of the newest generation want max_completion_tokens instead
#AI_MAX_TOKENS_PARAM=max_tokens
#AI_IMAGE_DETAIL=low
# Prices per 1M tokens in the provider's currency (rubles for proxyapi, dollars otherwise), used only to estimate
# the spend for AI_DAILY_BUDGET. The defaults are in cogs/ai/ai_client.py
#AI_CURRENCY=
#AI_PRICE_INPUT=7.58
#AI_PRICE_CACHED=0.81
#AI_PRICE_OUTPUT=21.05

# Cost protection in the provider`s currency. Daily limits reset at 00:00 UTC, 0 = unlimited
# Estimated spend of the WHOLE bot per day, AI pauses for everyone when it is reached.
AI_DAILY_BUDGET=100
AI_USER_DAILY_REQUESTS=30
AI_USER_DAILY_REQUESTS_VOTED=100
AI_GUILD_DAILY_REQUESTS=300
AI_MAX_INPUT_CHARS=2000
AI_MAX_OUTPUT_TOKENS=600
AI_VOICE_MAX_TOKENS=350
AI_MAX_IMAGES=2
AI_MAX_CONCURRENCY=4
AI_MAX_MESSAGES=20
AI_MAX_MESSAGES_VOTED=40
AI_HISTORY_MAX_CHARS=8000
AI_HISTORY_MAX_CHARS_VOTED=16000
AI_REQUEST_TIMEOUT_SECONDS=60
AI_COOLDOWN_SECONDS=30
AI_COOLDOWN_SECONDS_VOTED=10

#Traps
TRAPS_DEFAULT_TIMEOUT=300